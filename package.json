{
  "name": "epub-generate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run check && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run lint:check && pnpm run typecheck && pnpm run test",
    "prepare": "husky"
  },
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "chardet": "^2.1.1",
    "jszip": "^3.10.1",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/carbon": "^1.2.13",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.73.0",
    "unocss": "^66.5.1",
    "vite": "^7.1.2",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,vue}": "eslint --fix --no-warn-ignored"
  }
}
